<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>me.bartoszkomisarczyk</groupId>
	<artifactId>zr7</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Zadanie Rekrutacyjne 7</name>
	<description>REST service for managing discount coupons:
		creation and usage registration with case-insensitive codes,
		per-country restriction via IP geolocation,
		per-user single-use enforcement,
		and concurrency-safe usage limits.
	</description>
	<url>https://github.com/komisarczykb/zr7</url>
	<licenses>
		<license>
			<name>MIT License</name>
			<url>https://opensource.org/licenses/MIT</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<name>Bartosz Komisarczyk</name>
			<email>komisarczykb@gmail.com</email>
			<url>https://github.com/komisarczykb</url>
			<roles>
				<role>Developer</role>
			</roles>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:git://github.com/komisarczykb/zr7.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/komisarczykb/zr7.git</developerConnection>
		<url>https://github.com/komisarczykb/zr7</url>
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
