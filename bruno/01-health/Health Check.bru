meta {
  name: Health Check
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/actuator/health
  body: none
  auth: none
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status is UP", function () {
    expect(res.getBody().status).to.equal("UP");
  });
}