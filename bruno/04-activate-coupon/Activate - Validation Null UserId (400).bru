meta {
  name: Activate - Validation Null UserId (400)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/coupons/activate
  body: json
  auth: none
}

body:json {
  {
    "code": "SUMMER2026",
    "userId": null,
    "userIp": "{{usIp}}"
  }
}

tests {
  test("returns 400 Bad Request", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
