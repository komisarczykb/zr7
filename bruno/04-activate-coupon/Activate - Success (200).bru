meta {
  name: Activate - Success (200)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/coupons/activate
  body: json
  auth: none
}

body:json {
  {
    "code": "USONLY",
    "userId": 1001,
    "userIp": "{{usIp}}"
  }
}

docs {
  Depends on "Create - US Coupon For Activation Tests (USONLY)" having run first.
}

tests {
  test("returns 200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status is SUCCESS", function () {
    expect(res.getBody().status).to.equal("SUCCESS");
  });
}
